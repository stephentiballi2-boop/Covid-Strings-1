covid strings subscription models
how to program subscription models for covid strings
npm install express mongoose body-parser
const express=require(express);
const mongoose=require(mongoose);
const bodyparser=require(body-parser);
const app=express();
app.use(bodyparser.json());
// connect to mongodb
mongoose.connect(mongodb://localhost:27017/subscriptiondb, {
usenewurlparser: true,
useunifiedtopology: true,
});
// define subscription schema
const subscriptionschema=new mongoose.schema({
userid: string,
plan: string, // e.g., 'basic', 'premium', 'pro'
startdate: {type: date, default: date.now },
enddate: date,
isactive: {type: boolean, default: true },
});
// create subscription model
const subscription=mongoose.model(subscription, subscriptionschema);
// create a new subscription
app.post(/subscribe, async (req,res) => {
const {userid, plan, enddate } =req.body;
try {
const newsubscription=new subscription({userid,plan,enddate });
await newsubscription.save();
res.status(201).send({message: subscription created successfully!, subscription: newsubscription });
} catch (error) {
res.status(500).send({message: error creating subscription, error });
}
});
// get all subscriptions
app.get(/subscriptions, async (req,res) => {
try {
const subscriptions =await subscription.find();
res.status(200).send(subscriptions);
} catch (error) {
res.status(500).send({message: error fetching subscriptions, error });
}
});
// cancel a subscription
app.put(/cancel/:id, async (req,res) => {
const {id}=req.params;
try {
const subscription=await subscription.findbyidandupdate(
id,
{isactive: false },
{new: true }
);
if (!subscription) {
return res.status(404).send({message: subscription not found});
}
res.status(200).send({message: subscription canceled, subscription });
} catch (error) {
res.status(500).send({message: error canceling subscription,error });
}
});
// start the server
const port = 3000;
app.listen(port, () => {
console.log(server running on http://localhost:${port});
});
