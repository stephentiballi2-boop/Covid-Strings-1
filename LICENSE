covid strings updating and deleting royalty records
how to update and delete royalty records in the covid strings royalty database
async function updateroyaltyrecord(recordid,updateddata) {
try {
const response =await fetch(https://covid-strings-1.com/royalties/${recordid}, {
method: put,
headers: {
content-type: application/json,
},
body: json.stringify(updateddata),
});
if (response.ok) {
const result = await response.json();
console.log(record updated successfully:, result);
} else {
console.error(failed to update record:, response.statustext);
}
} catch (error) {
console.error(error updating record:,error);
}
}
// example usage:
updateroyaltyrecord(123, {artistname: stephen tiballi, royaltyamount: 5000 });
async function deleteroyaltyrecord(recordid) {
try {
const response=await fetch(https://covid-strings-1.com/royalties/${recordid}, {
method: delete,
});
if (response.ok) {
console.log(record with id ${recordid} deleted successfully.);
} else {
console.error(failed to delete record:, response.statustext);
}
} catch (error) {
console.error(error deleting record:,error);
}
}
// example usage:
deleteroyaltyrecord(123);
