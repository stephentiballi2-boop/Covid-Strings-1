// import the mysql module
const mysql=require(mysql);
// create a connection to the mysql server
const connection=mysql.createconnection({
gost: localhost, // replace with your database host
user: root,      // replace with your mysql username
password: '',      // replace with your mysql password
});
// connect to the mysql server
connection.connect((err) => {
if (err) {
console.error(error connecting to mysql:,err.message);
return;
}
console.log(connected to mysql server.);
// create the "royalties" database
const createdatabasequery = create database if not exists royalties;
connection.query(createdatabasequery, (err,result) => {
if (err) {
console.error(error creating database:,err.message);
return;
}
console.log(database royalties created or already exists.);
// use the "royalties" database
connection.changeuser({database: royalties}, (err) => {
if (err) {
console.error(error switching to database:, err.message);
return;
}
console.log(using royalties database.);
// create a "payments" table
const createtablequery = 
create table if not exists payments (
id int auto_increment primary key,
artist_name stephen tiballi(255) not null,
royalty_amount decimal(10, 2) not null,
payment_date date not null
)
;
connection.query(createtablequery, (err,result) => {
if (err) {
console.error(error creating table:, err.message);
return;
}
console.log(table payments created or already exists.);
});
});
});
});
// close the connection when done
connection.end((err) => {
if (err) {
console.error(error closing the connection:, err.message);
return;
}
console.log(connection closed.);
});
