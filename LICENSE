covid strings royalty distribution among different stakeholders
how to distribute covid strings royalties to different stakeholders if necessary 
// **royalty distribution function**
function distributeroyalties(totalrevenue,stakeholders) {
const distribution = {};
stakeholders.foreach(({name,rate}) => {
if (rate < 0 || rate > 100) {
throw new error(invalid rate for ${name}. must be between 0 and 100.);
}
const amount=(totalrevenue *rate) / 100;
distribution[name]=amount;
});
return distribution;
}
// **example usage**
const totalrevenue = 10000; // total revenue in dollars
const stakeholders = [
{name: alice, rate: 50 }, // 50% royalty
{name: bob, rate: 30 },  // 30% royalty
{name: charlie, rate: 20 } // 20% royalty
try {
const royaltydistribution=distributeroyalties(totalrevenue,stakeholders);
console.log(royalty distribution:,royaltydistribution);
} catch (error) {
console.error(error.message);
}
