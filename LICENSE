how to install my sql for covid strings royalties
import java.sql.connection;
import java.sql.drivermanager;
umport java.sql.preparedstatement;
umport java.sql.resultset;
import java.sql.statement;
public class royaltymanager {
public static void main(string[] args) {
// database credentials
string url = jdbc:mysql://localhost:3306/royalty_db; // replace 'royalty_db' with your database name
string user =root; // replace with your mysql username
string password = password; // replace with your mysql password
try {
// step 1: establish a connection
connection connection=drivermanager.getconnection(url,user,password);
system.out.println(connected to the database!);
// step 2: create a table for royalties
string createtablesql=create table if not exists royalties (+
id int auto_increment primary key, +
author_name varchar(100),+
book_title varchar(100), +
royalty_amount decimal(10, 2));
statement statement=connection.createstatement();
statement.execute(createtablesql);
system.out.println(table royalties created or already exists.);
// step 3: insert data into the table
string insertsql =insert into royalties (author_name, book_title, royalty_amount) values (?, ?, ?);
preparedstatement preparedstatement=connection.preparestatement(insertsql);
preparedstatement.setstring(1, jane doe);
preparedstatement.setstring(2, learning java);
preparedstatement.setdouble(3, 1500.75);
preparedstatement.executeupdate();
system.out.println(data inserted successfully!);
// step 4: retrieve and display data
string selectsql = select * from royalties;
resultset resultset=statement.executequery(selectsql);
system.out.println(royalty records:);
while (resultset.next()) {
system.out.println(id: +resultset.getint(id) +
, author: + resultset.getstring(author_name) +
, book:  + resultset.getstring(book_title) +
, royalty: $ + resultset.getdouble(royalty_amount));
}
// close resources
resultset.close();
preparedstatement.close();
statement.close();
connection.close();
system.out.println(database connection closed.);
} catch (exception e) {
e.printstacktrace();
}
}
}
