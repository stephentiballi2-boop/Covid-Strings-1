covid strings subscription royalties 
how to calculate covid strings subscription royalties
class subscriptionroyalty {
constructor(subscriptionfee,royaltypercentage) {
this.subscriptionfee=subscriptionfee;
this.royaltypercentage=royaltypercentage;
}
calculateroyalty(subscribers) {
return subscribers * this.subscriptionFee * (this.royaltypercentage / 100);
}
}
// example usage:
const subscription =new subscriptionroyalty(10, 20); // $10 fee, 20% royalty
const totalroyalty=subscription.calculateroyalty(500); // 500 subscribers
console.log(total royalty from subscriptions: $${totalroyalty.tofixed(2)});
