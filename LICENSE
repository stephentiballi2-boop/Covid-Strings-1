covid strings creator royalties
how to calculate covid strings creator royalties 
function calculateroyalty(totalrevenue, royaltypercentage) {
if (totalrevenue < 0 || royaltypercentage < 0 || royaltypercentage > 100) {
throw new error(invalid input values.);
}
return (totalrevenue *royaltypercentage) / 100;
}
// example usage:
const totalrevenue = 10000; // total revenue in dollars
const royaltypercentage = 15; // royalty percentage
const royalty=calculateroyalty(totalrevenue,royaltypercentage);
console.log(the royalty amount is $${royalty.tofixed(2)});
