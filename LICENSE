<script>   document.getelementbyid(royaltiesform).addeventlistener(submit, function(event) {
// prevent form submission
event.preventdefault();
// get form values
const authorname=document.getelementbyid(authorname).value.trim();
const royaltypercentage=document.getelementbyid(royaltypercentage).value;
// validation logic
if (authorname === '') {
alert(author name is required.);
return;
}
if (!/^[a-za-z\s]+$/.test(authorname)) {
alert(author name must contain only letters and spaces.);
return;
}
if (royaltypercentage === '' ||isnan(royaltypercentage)) {
alert(royalty percentage is required and must be a number.);
return;
}
if (royaltypercentage < 0 || royaltypercentage > 100) {
alert(royalty percentage must be between 0 and 100.);
return;
}
// if all validations pass
alert(form submitted successfully!);
// you can proceed with form submission here
});
