<subheading.html>
covid strings error handling of royalties
how to calculate errors so that royalties can be correctly programmed
function calculateroyalties(sales,royaltyrate) {
try {
// validate inputs
if (typeof sales !== number || typeof royaltyrate !== number) {
throw new typeError(both sales and royaltyrate must be numbers.);
}
if (sales < 0 || royaltyrate < 0) {
throw new rangeerror(sales and royaltyrate cannot be negative.);
}
if (royaltyrate > 1) {
throw new rangeerror(royalty rate must be a decimal (e.g., 0.1 for 10%).);
}
// calculate royalties
const royalties=sales * royaltyrate;
console.log(royalties calculated: $${royalties.tofixed(2)});
return royalties;
} catch (error) {
// handle errors
if (error instanceof typeerror) {
console.error(type error:,error.message);
} else if (error instanceof rangeerror) {
console.error(range error:,error.message);
} else {
console.error(unexpected error:,error.message);
}
} finally {
console.log(royalties calculation process completed.);
}
}
// example usage
calculateroyalties(1000, 0.1); // valid input
calculateroyalties(-500, 0.1); // invalid input (negative sales)
calculateroyalties(1000, 10%); // invalid input (wrong type)
return filename
